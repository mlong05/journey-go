# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

.idea/
**/target/

# Environment Variables
.env
.env.*
!.env.example

# Android/Gradle build artifacts
mobile/android/build/

# Database backups
*.dump
backups/
!backups/.gitkeep
.worktrees/

# GitHub Actions self-hosted runner (chứa token đăng ký — KHÔNG commit)
.runner/
_work/

# Secrets dùng cho self-hosted deploy (KHÔNG commit — file .env để deploy)
.secrets/

# Trạng thái trung gian dùng để tách commit (chỉ làm việc cục bộ — KHÔNG commit)
.commit-split/

# Scratch design refs (KHÔNG commit)
frontend/public/_ref-*

# Next.js build output (frontend/.next) — không commit
frontend/.next/
.next/
node_modules/

# Log chạy dev server cục bộ (KHÔNG commit)
frontend/dev.out
frontend/dev.err
backend/run.out
backend/run.err
