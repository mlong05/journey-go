# =====================================================================================
#  JourneyGo — Self-hosted Deployment (Docker Compose)
#  Copy file này thành `.env` ở thư mục gốc rồi điền giá trị thật:
#      cp .env.example .env      (Windows: copy .env.example .env)
#
#  ⚠️ `.env` đã được .gitignore ⇒ KHÔNG BAO GIỜ commit file này lên GitHub.
#  ⚠️ Tất cả secret bên dưới đều phải lấy từ dashboard của dịch vụ tương ứng.
# =====================================================================================

# ─────────────────────────────────────────────────────────────────────────────
#  1. DOMAIN PUBLIC & CLOUDLARE TUNNEL
# ─────────────────────────────────────────────────────────────────────────────
# Tunnel token lấy tại: Cloudflare Zero Trust → Networks → Tunnels → journeygo-tunnel
# (Command để cài token: `docker run cloudflare/cloudflared:latest tunnel token`)
# ⚠️ Token là Base64 JSON chứa account tag + tunnel ID + secret ⇒ TUYỆT ĐỐI
#    không commit file này lên Git.
#
# Script tự động lấy token + tạo DNS record:
#   .\scripts\cloudflare\setup-tunnel.ps1 `
#     -TunnelId "69029562-7567-4f58-ac76-aaec8ed04892" -Hostname "journeygo.id.vn"
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Tunnel ID (dùng cho DNS CNAME record trong Cloudflare).
# DNS record cần: Type CNAME (hoặc type "Tunnel"), Name `@`, Target
# `<TUNNEL_ID>.cfargotunnel.com`, Proxy: Proxied, TTL: Auto.
CLOUDFLARE_TUNNEL_ID=69029562-7567-4f58-ac76-aaec8ed04892

# Domain public đang trỏ về tunnel (đã cấu hình Public Hostname trong Cloudflare).
PUBLIC_DOMAIN=journeygo.id.vn

# ─────────────────────────────────────────────────────────────────────────────
#  2. DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ ĐỔI MẬT KHẨU mặc định trước khi deploy thật.
#     Sinh mật khẩu mạnh: openssl rand -base64 32
POSTGRES_DB=journeygo_db
POSTGRES_USER=journeygo
POSTGRES_PASSWORD=your-strong-postgres-password

# ─────────────────────────────────────────────────────────────────────────────
#  3. REDIS
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ Để trống = không đặt mật khẩu (chỉ dùng cho mạng nội bộ Docker).
#     Đặt mật khẩu nếu expose ra ngoài (khuyến nghị cho production).
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
#  4. BACKEND — SPRING PROFILE & URL NỘI BỘ
# ─────────────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
LOGGING_LEVEL=INFO

# JDBC URL trong Docker network (KHÔNG dùng localhost — container khác nhau).
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/journeygo_db
SPRING_DATASOURCE_USERNAME=journeygo
SPRING_DATASOURCE_PASSWORD=your-strong-postgres-password

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
#  5. BACKEND — SECRET (KHÔNG DÙNG GIÁ TRỊ MẪU)
# ─────────────────────────────────────────────────────────────────────────────
# Sinh: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-min-256-bit
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─────────────────────────────────────────────────────────────────────────────
#  6. BACKEND — CORS / OAUTH (dùng domain public)
# ─────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://journeygo.id.vn,https://www.journeygo.id.vn
OAUTH2_DEFAULT_REDIRECT_URI=https://journeygo.id.vn/oauth2/redirect
OAUTH2_AUTHORIZED_REDIRECT_URIS=https://journeygo.id.vn/oauth2/redirect,http://localhost:3000/oauth2/redirect,http://127.0.0.1:3000/oauth2/redirect,journeygo://oauth2/redirect,journeygo://auth/callback

# Google Cloud Console → Credentials → Web application → Authorized redirect URIs:
#   https://journeygo.id.vn/oauth2/redirect
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────────────────────────────────────
#  7. BACKEND — MAIL (SMTP domain @journeygo.id.vn)
# ─────────────────────────────────────────────────────────────────────────────
# Mail server của tên miền: mail.journeygo.id.vn (cổng 587 — STARTTLS)
# Tài khoản dùng để gửi: contact@journeygo.id.vn
SPRING_MAIL_HOST=mail.journeygo.id.vn
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=contact@journeygo.id.vn
SPRING_MAIL_PASSWORD=your-mail-password
MAIL_FROM_NAME=JourneyGo Platform
MAIL_OTP_EXPIRATION_MINUTES=10

# ─────────────────────────────────────────────────────────────────────────────
#  8. BACKEND — CLOUDINARY (upload ảnh/video)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─────────────────────────────────────────────────────────────────────────────
#  9. BACKEND — VNPAY SANDBOX
# ─────────────────────────────────────────────────────────────────────────────
VNPAY_ENABLED=true
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_VERSION=2.1.0
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_MERCHANT_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# URL public (Cloudflare Tunnel) — phải là HTTPS, truy cập được từ internet.
VNPAY_IPN_URL=https://journeygo.id.vn/api/v1/payments/ipn
VNPAY_RETURN_URL=https://journeygo.id.vn/api/v1/payments/return-page
# Web redirect về trang kết quả của frontend.
VNPAY_WEB_RETURN_URL=https://journeygo.id.vn/payment/result
# Deep link về app mobile (custom scheme — KHÔNG cần tunnel).
VNPAY_APP_REDIRECT_ENABLED=false
VNPAY_APP_SCHEME=journeygo
VNPAY_APP_RETURN_URL=journeygo://payment/return
VNPAY_IP_ADDR=127.0.0.1
VNPAY_TIMEZONE=Asia/Ho_Chi_Minh
VNPAY_EXPIRY_MINUTES=10
VNPAY_API_TIMEOUT_MS=15000
VNPAY_VERIFY_SIGNATURE=true
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_BANK_CODE=
VNPAY_BANK_LIST_URL=https://sandbox.vnpayment.vn/qrpayauth/api/merchant/get_bank_list
VNPAY_QR_BANK_TYPE=1
VNPAY_DOMESTIC_CARD_BANK_TYPE=2
VNPAY_INTERNATIONAL_CARD_BANK_TYPE=3

# ─────────────────────────────────────────────────────────────────────────────
#  10. BACKEND — AI & MAPS
# ─────────────────────────────────────────────────────────────────────────────
GOONG_API_KEY=your-goong-rest-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────────────────────────────────────
#  11. BACKEND — NGHIỆP VỤ (finance / refund / flyway)
# ─────────────────────────────────────────────────────────────────────────────
FLYWAY_ENABLED=true
REFUND_WINDOW_HOURS=24
DEFAULT_COMMISSION_RATE=0.2000
REFUND_RATE_TOURIST_FAULT=0.50
REFUND_RATE_PLATFORM_FAULT=1.00
SETTLEMENT_GRACE_MINUTES=0
ALLOW_OPEN_PERIOD_SETTLEMENT=false
BOOKING_EXPIRY_SCAN_INTERVAL_SECONDS=60
BOOKING_INVITATION_APP_URL=journeygo://booking/invitations/accept
REFUND_STATUS_CHECK_INTERVAL_SECONDS=300
REFUND_RESUBMIT_WINDOW_HOURS=0

# ─────────────────────────────────────────────────────────────────────────────
#  12. FRONTEND (Next.js) — build-time env
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ Next.js INLINE giá trị lúc build ⇒ biến này phải có TRƯỚC khi `docker compose build`.
NEXT_PUBLIC_API_URL=https://journeygo.id.vn/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOONG_MAPTILES_KEY=your-goong-maptiles-key
NEXT_PUBLIC_MOCK_PAYMENT=false

# ─────────────────────────────────────────────────────────────────────────────
#  13. MOBILE (Flutter) — file mobile/.env
# ─────────────────────────────────────────────────────────────────────────────
# API public để điện thoại thật truy cập (KHÔNG dùng localhost trên máy khác).
MOBILE_API_BASE_URL=https://journeygo.id.vn/api/v1
MOBILE_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
MOBILE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
MOBILE_GOONG_MAPTILES_KEY=your-goong-maptiles-key
