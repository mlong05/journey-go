# ========================================================
# JourneyGo Frontend — Local environment config
# Copy thành `.env.local` rồi điền giá trị thật:
#   cp .env.example .env.local   (Windows: copy .env.example .env.local)
# `.env.local` đã nằm trong .gitignore — KHÔNG commit file này.
# ========================================================

# Backend API (trình duyệt gọi trực tiếp).
NEXT_PUBLIC_API_URL=http://localhost:8088/api/v1

# Google OAuth2 Client ID (Web).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Khóa **Maptiles** của Goong cho bản đồ nền tiếng Việt.
#   account.goong.io → Keys → tạo key loại **Maptiles**, giới hạn theo tên miền
#   (vd: localhost và journeygo.vn).
# KHÁC với khóa REST GOONG_API_KEY ở backend (backend/.env).
# Thiếu key này: modal chọn vị trí không vẽ được bản đồ, nhưng vẫn nhập tọa độ tay được.
NEXT_PUBLIC_GOONG_MAPTILES_KEY=

# Cho phép mô phỏng thanh toán (VNPay sandbox) — chỉ dùng khi phát triển.
NEXT_PUBLIC_MOCK_PAYMENT=false
