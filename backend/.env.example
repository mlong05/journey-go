# ========================================================
# JourneyGo Backend Environment Configuration Template
# Sao chép file này thành .env và điền các giá trị thực tế
# ========================================================

# Server Port
PORT=8088

# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/journeygo_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=1

# JWT Secret & Expiration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Gmail SMTP Configuration (Dùng Mật khẩu ứng dụng 16 ký tự của Google)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_NAME=JourneyGo Platform
MAIL_OTP_EXPIRATION_MINUTES=10

# Google OAuth2 Client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS & OAuth2 Redirect
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OAUTH2_DEFAULT_REDIRECT_URI=http://localhost:3000/oauth2/redirect

# CLOUDINARY FOR IMAGE
CLOUDINARY_CLOUD_NAME=blr9kaqk
CLOUDINARY_API_KEY=143924326641418
