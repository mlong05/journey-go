# ========================================================
# Finance (Refund / Settlement)
# ========================================================
# Thá»i háº¡n gá»­i yÃªu cáº§u hoÃ n tiá»n ká»ƒ tá»« thá»i Ä‘iá»ƒm thanh toÃ¡n thÃ nh cÃ´ng Ä‘Ã£ xÃ¡c minh.
REFUND_WINDOW_HOURS=24
# Tá»· lá»‡ hoa há»“ng ná»n táº£ng máº·c Ä‘á»‹nh (0.20 = 20%).
DEFAULT_COMMISSION_RATE=0.2000
# Tá»· lá»‡ hoÃ n tiá»n theo nguyÃªn nhÃ¢n.
REFUND_RATE_TOURIST_FAULT=0.50
