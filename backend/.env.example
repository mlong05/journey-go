# ========================================================
# VNPay Sandbox (Booking - Payment - Refund)
# Láº¥y tmn-code / hash-secret táº¡i:
#   https://sandbox.vnpayment.vn/devreg/  (Ä‘Äƒng kÃ½ â†’ nháº­n qua email)
# Hoáº·c xem táº¡i Merchant Admin â†’ ThÃ´ng tin tÃ i khoáº£n.
# Sandbox máº·c Ä‘á»‹nh: tmn-code=DEMOV210
# ========================================================
VNPAY_ENABLED=true
VNPAY_TMN_CODE=G46V3SQ0
# !!! QUAN TRá»ŒNG: Ä‘iá»n secret tháº­t á»Ÿ file .env â€” KHÃ”NG Ä‘á»ƒ trá»‘ng.
# Thiáº¿u secret â†’ API tráº£ 400 "Thiáº¿t láº­p VNPay chÆ°a Ä‘Æ°á»£c cáº¥u hÃ¬nh".
VNPAY_HASH_SECRET=
VNPAY_VERSION=2.1.0
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_MERCHANT_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# IPN URL â€” VNPay gá»i server-to-server. Pháº£i lÃ  HTTPS, truy cáº­p Ä‘Æ°á»£c tá»« internet.
# Trong mÃ´i trÆ°á»ng local dÃ¹ng ngrok/tunnel:
#   ngrok http 8088
#   => VNPAY_IPN_URL=https://<subdomain>.ngrok-free.dev/api/v1/payments/ipn
# Khai bÃ¡o URL nÃ y táº¡i: https://sandbox.vnpayment.vn/vnpaygw-sit-testing/ipn
# hoáº·c Merchant Admin â†’ TerminalEdit.htm
VNPAY_IPN_URL=

# Return URL â€” VNPay redirect ngÆ°á»i dÃ¹ng vá» sau khi thanh toÃ¡n.
#   => VNPAY_RETURN_URL=https://<subdomain>.ngrok-free.dev/api/v1/payments/return-page
# !!! PHAI la URL PUBLIC (ngrok), KHONG dung localhost:
#     trinh duyet tren dien thoai mo "localhost" = chinh dien thoai
#     => khong toi duoc backend => mobile khong quay lai duoc app.
#     (localhost chi dung duoc khi VNPay chap nhan - nen dung ngrok cho ca 2)
VNPAY_RETURN_URL=https://<subdomain>.ngrok-free.dev/api/v1/payments/return-page

# Return URL riêng cho WEB (frontend Next.js) — để trống thì dùng VNPAY_RETURN_URL.
# Trang này tự poll GET /payments/{id} để hiện kết quả thanh toán.
VNPAY_WEB_RETURN_URL=

# -- Deep link ve app mobile ------------------------------------------------
# Mobile gui `appRedirect=true` khi khoi tao giao dich => Return URL duoc gan
# `app_redirect=1` => trinh duyet chuyen huong ve app (`journeygo://payment/return`)
# => app mo lai va hien man ket qua ngay.
# Dat `VNPAY_APP_REDIRECT_ENABLED=true` de bat cho TAT CA giao dich
# (khi do WEB cung bi chuyen huong ve app - thuong KHONG nen).
# Scheme deep link phai khop voi AndroidManifest
# (mobile/android/app/src/main/AndroidManifest.xml).
VNPAY_APP_REDIRECT_ENABLED=false
VNPAY_APP_SCHEME=journeygo

# -- Return URL riêng cho APP MOBILE (custom scheme) -------------------------
# ĐÃ KIỂM CHỨNG TRÊN SANDBOX: khi vnp_ReturnUrl là CUSTOM SCHEME, VNPay chuyển
# hướng trình duyệt thẳng về scheme này kèm TOÀN BỘ tham số kết quả ĐÃ KÝ
# (vnp_ResponseCode, vnp_TransactionStatus, vnp_TransactionNo, vnp_PayDate,
#  vnp_SecureHash) ⇒ app nhận kết quả NGAY, KHÔNG CẦN ngrok/tunnel còn sống,
#  và không phụ thuộc lệnh querydr (Sandbox đang trả lỗi 99 cho mọi giao dịch).
#
#   => VNPAY_APP_RETURN_URL=journeygo://payment/return
#
# Để trống ⇒ dùng VNPAY_RETURN_URL + app_redirect=1 (CẦN ngrok còn sống).
VNPAY_APP_RETURN_URL=journeygo://payment/return

# IP server gá»­i lÃªn VNPay (vnp_IpAddr)
VNPAY_IP_ADDR=127.0.0.1
VNPAY_TIMEZONE=Asia/Ho_Chi_Minh
VNPAY_EXPIRY_MINUTES=10
VNPAY_API_TIMEOUT_MS=15000
# KHÃ”NG Ä‘Æ°á»£c Ä‘áº·t false trong production.
VNPAY_VERIFY_SIGNATURE=true
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other

# â”€â”€ vnp_BankCode â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Äá»‚ TRá»NG (máº·c Ä‘á»‹nh) â†’ KHÃ”NG gá»­i vnp_BankCode â†’ VNPay chuyá»ƒn khÃ¡ch tá»›i trang CHá»ŒN
# phÆ°Æ¡ng thá»©c thanh toÃ¡n. ÄÃ¢y lÃ  hÃ nh vi Ä‘Ãºng vá»›i 3 lá»±a chá»n trÃªn Sandbox:
#   1. á»¨ng dá»¥ng NgÃ¢n hÃ ng vÃ  VÃ­ Ä‘iá»‡n tá»­
