# Hoáº·c mÃ£ ngÃ¢n hÃ ng cá»¥ thá»ƒ (MB, VCB, ZINGPAYâ€¦) â€” xem API get_bank_list.
VNPAY_BANK_CODE=

# URL láº¥y danh sÃ¡ch ngÃ¢n hÃ ng / phÆ°Æ¡ng thá»©c thanh toÃ¡n (API chÃ­nh thá»©c VNPay).
VNPAY_BANK_LIST_URL=https://sandbox.vnpayment.vn/qrpayauth/api/merchant/get_bank_list

# Mapping bank_type cá»§a API get_bank_list sang 3 nhÃ³m phÆ°Æ¡ng thá»©c.
# TÃ i liá»‡u chÃ­nh thá»©c KHÃ”NG nÃªu rÃµ mÃ£ sá»‘ â†’ Ä‘Ã¢y lÃ  giÃ¡ trá»‹ Máº¶C Äá»ŠNH, chá»‰nh láº¡i náº¿u cáº§n.
