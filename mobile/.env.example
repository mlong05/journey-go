# ========================================================
# JourneyGo Mobile — Environment Configuration Template
# Sao chép file này thành `.env` rồi điền giá trị thật.
# File `.env` đã được .gitignore bỏ qua — KHÔNG commit.
# ========================================================

# Google OAuth2 Client ID (Android) — lấy trong Google Cloud Console.
# Được dùng bởi `ApiConstants.googleAndroidClientId`.
GOOGLE_ANDROID_CLIENT_ID=

# Base URL của backend (tuỳ chọn).
# Bỏ trống → dùng mặc định theo môi trường:
#   Android Emulator : http://10.0.2.2:8088/api/v1
#   iOS / Desktop    : http://127.0.0.1:8088/api/v1
API_BASE_URL=
