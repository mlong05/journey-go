# ========================================================
# JourneyGo Mobile — Environment Configuration Template
# Sao chép file này thành `.env` rồi điền giá trị thật.
# File `.env` đã được .gitignore bỏ qua — KHÔNG commit.
# ========================================================

# Google OAuth2 Client ID — lấy trong Google Cloud Console.
# Được dùng bởi `ApiConstants.googleAndroidClientId` / `ApiConstants.googleWebClientId`.
GOOGLE_ANDROID_CLIENT_ID=490727174189-8dv7431hih3r0t9hi8971mar0oj8estv.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=490727174189-ujku7rk195gbechu4billtnkvacpg8bu.apps.googleusercontent.com

# Thanh toán giả lập (CHỈ dùng khi dev)
MOCK_PAYMENT=false

# Base URL của backend (tuỳ chọn).
# Bỏ trống → app tự dò:
#   máy ảo dùng 10.0.2.2, cắm USB + "adb reverse tcp:8088 tcp:8088" dùng 127.0.0.1.
# Địa chỉ backend cho điện thoại thật (IP Wi-Fi của máy tính, cùng mạng).
# API_BASE_URL=http://192.168.1.5:8088/api/v1
API_BASE_URL=
