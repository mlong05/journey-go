# ========================================================
# JourneyGo Mobile — Environment Configuration Template
# Sao chép file này thành `.env` rồi điền giá trị thật.
# File `.env` đã được .gitignore bỏ qua — KHÔNG commit.
# ========================================================

# Google OAuth2 Client ID — lấy trong Google Cloud Console.
# Được dùng bởi `ApiConstants.googleAndroidClientId` / `ApiConstants.googleWebClientId`.
# ⚠️ Client ID là thông tin "public" (nhúng trong app) nhưng vẫn nên để trong .env
#    để dễ đổi theo môi trường (dev / prod) mà không sửa code.
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Thanh toán giả lập (CHỈ dùng khi dev)
MOCK_PAYMENT=false

# Base URL của backend (tuỳ chọn).
# Bỏ trống → app tự dò:
#   backend local Docker (8080) hoặc mvnw (8088); máy ảo dùng 10.0.2.2,
#   điện thoại thật cắm USB chạy mobile/run-usb.sh (adb reverse) dùng 127.0.0.1.
# Có giá trị → app CHỈ dùng đúng địa chỉ đó (vd https://journeygo.id.vn/api/v1).
# Địa chỉ backend cho điện thoại thật (IP Wi-Fi của máy tính, cùng mạng).
# API_BASE_URL=http://192.168.1.5:8088/api/v1
API_BASE_URL=

# Khóa Maptiles của Goong cho bản đồ nền tiếng Việt (KHÁC khóa REST GOONG_API_KEY ở backend).
#   account.goong.io → Keys → tạo key loại Maptiles, giới hạn theo tên gói com.journeygo.mobile.
# Bỏ trống → dùng bản đồ Esri như cũ.
GOONG_MAPTILES_KEY=your-goong-maptiles-key
